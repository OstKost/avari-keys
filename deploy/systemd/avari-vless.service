[Unit]
Description=Avari Keys VLESS Reality
After=network.target

[Service]
DynamicUser=yes
LoadCredential=config.json:/etc/avari-vless/config.json
ExecStart=/usr/local/bin/xray run -c %d/config.json
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
